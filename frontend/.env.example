# ==========================================
# Floveera Customer Frontend - Environment Configuration
# ==========================================

# Backend API Endpoint (Points to deployed Render backend URL including /api)
NEXT_PUBLIC_API_URL=https://your-floveera-backend.onrender.com/api

# Partner / CRM Application URL (Optional: used if linking to the restaurant portal)
NEXT_PUBLIC_CRM_APP_URL=https://your-floveera-crm.vercel.app

# Firebase Client SDK (Optional: For Google Sign-In & Firebase Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000
