# ==========================================
# Floveera Restaurant CRM - Environment Configuration
# ==========================================

# Backend API Endpoint (Points to deployed Render backend URL including /api)
NEXT_PUBLIC_API_URL=https://your-floveera-backend.onrender.com/api

# WebSocket Server URL (Points to deployed Render backend base origin without /api)
NEXT_PUBLIC_SOCKET_URL=https://your-floveera-backend.onrender.com

# Customer Store Application URL (Used for "Back to Store" links and unauthorized redirects)
NEXT_PUBLIC_CUSTOMER_URL=https://your-floveera-store.vercel.app
NEXT_PUBLIC_CUSTOMER_APP_URL=https://your-floveera-store.vercel.app
